/dts-v1/;
#include <atmel/same5xx19.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include "same51j_hotswap_controller-pinctrl.dtsi"

/ {
	model = "LTC4281 Hot Swap Controller";
	compatible = "custom,ltc4281-hotswap-controller";

	chosen {
		zephyr,console = &sercom5;
		zephyr,shell-uart = &sercom5;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
	};

	aliases {
		led0 = &led0;
		i2c-0 = &sercom2;
	};

	leds {
		compatible = "gpio-leds";

		led0: led_0 {
			gpios = <&porta 18 GPIO_ACTIVE_HIGH>;   /* change to your LED pin */
			label = "Status LED";
		};
	};
};

&cpu0 {
	clock-frequency = <120000000>;
};

&sercom5 {
	compatible = "atmel,sam0-uart";
	current-speed = <115200>;
	rxpo = <1>;   /* RX on PAD1 = PB03 */
	txpo = <0>;   /* TX on PAD0 = PB02 */
	pinctrl-0 = <&sercom5_uart_default>;
	pinctrl-names = "default";
	status = "okay";
};

&sercom2 {
	compatible = "atmel,sam0-i2c";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-0 = <&sercom2_i2c_default>;
	pinctrl-names = "default";
	status = "okay";
};
