/dts-v1/;
#include <atmel/same5xx19.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include "same51j_hotswap_controller-pinctrl.dtsi"

/ {
	model = "LTC4281 Hot Swap Controller";
	compatible = "custom,ltc4281-hotswap-controller";

	chosen {
		zephyr,console = &sercom1;
		zephyr,shell-uart = &sercom1;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
	};

	aliases {
		led0 = &led_green;
		led1 = &led_red;
		led2 = &led_orange;
		i2c-0 = &sercom0;
	};

	leds {
		compatible = "gpio-leds";

		led_red: led_red {
			gpios = <&portb 2 GPIO_ACTIVE_LOW>;
			label = "red";
		};

		led_green: led_green {
			gpios = <&portb 3 GPIO_ACTIVE_LOW>;
			label = "green";
		};

		led_orange: led_orange {
			gpios = <&porta 0 GPIO_ACTIVE_LOW>;
			label = "orange";
		};
	};

	zephyr,user {
		io-channels = <&adc0 4>, <&adc0 5>;
		io-channel-names = "vin", "vout";
	};
};

&cpu0 {
	clock-frequency = <120000000>;
};

&sercom1 {
	compatible = "atmel,sam0-uart";
	current-speed = <115200>;
	rxpo = <1>;
	txpo = <0>;
	pinctrl-0 = <&sercom1_uart_default>;
	pinctrl-names = "default";
	status = "okay";
};

&sercom0 {
	compatible = "atmel,sam0-i2c";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-0 = <&sercom0_i2c_default>;
	pinctrl-names = "default";
	status = "okay";
};

&adc0 {
	status = "okay";
	pinctrl-0 = <&adc0_default>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@4 {
		reg = <4>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,vref-mv = <3300>;/* VDDANA = 3V3 */
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
		zephyr,input-positive = <4>;
	};

	channel@5 {
		reg = <5>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,vref-mv = <3300>;/* VDDANA = 3V3 */
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
		zephyr,input-positive = <5>;
	};
};
